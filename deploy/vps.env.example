# .env for docker-compose.vps.yml (deploy/install-vps.sh writes this for you).

# PostgreSQL password (letters and digits only: it goes into a URL).
POSTGRES_PASSWORD=change-me-hex-only

# Admin token: log in to the dashboard with it; clients use it to connect.
# Generate one: openssl rand -hex 32
RAG_ADMIN_TOKEN=change-me

# Voyage AI key (pa-...). Optional here — you can add it in the dashboard.
RAG_VOYAGE_API_KEY=

# HTTPS: the DNS name of this server (used with --profile https).
ENOWX_DOMAIN=

# Where the dashboard port listens: 127.0.0.1 behind Caddy/another proxy,
# 0.0.0.0 to open http://SERVER-IP:7777 directly.
ENOWX_BIND=127.0.0.1
ENOWX_PORT=7777

# "prebuilt" skips the npm build of the dashboard (small VPS, < 2 GB RAM).
ENOWX_WEB_BUILD=build
